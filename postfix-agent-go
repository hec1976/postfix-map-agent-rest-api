func main() {
	rand.Seed(time.Now().UnixNano())

	globalPath := "global.json"
	configsPath := "configs.json"

	mustExist(globalPath)
	mustExist(configsPath)

	global := mustLoadGlobal(globalPath)
	appcfg := mustLoadInstances(configsPath, global)

	apiToken := os.Getenv("API_TOKEN")
	if apiToken == "" {
		apiToken = global.APIToken
	}
	if apiToken == "" {
		log.Fatalf("FATAL: API_TOKEN nicht gesetzt (ENV API_TOKEN oder global.json api_token)")
	}

	setupLogging(global)
	ensureStartupDirs(appcfg)

	mux := http.NewServeMux()

	route := func(method string, pattern string, h http.HandlerFunc) {
		mux.HandleFunc(pattern, func(w http.ResponseWriter, r *http.Request) {
			if r.Method == "OPTIONS" {
				applyCORS(w, r)
				w.WriteHeader(http.StatusNoContent)
				return
			}
			if r.Method != method {
				writeJSON(w, 404, map[string]any{"ok": 0, "error": "Not found"})
				return
			}
			h(w, r)
		})
	}

	any := func(pattern string, h http.HandlerFunc) {
		mux.HandleFunc(pattern, func(w http.ResponseWriter, r *http.Request) {
			if r.Method == "OPTIONS" {
				applyCORS(w, r)
				w.WriteHeader(http.StatusNoContent)
				return
			}
			h(w, r)
		})
	}

	withAuth := func(h http.HandlerFunc) http.HandlerFunc {
		return func(w http.ResponseWriter, r *http.Request) {
			applyCORS(w, r)

			if global.RequireHTTPS && !isHTTPS(r) {
				writeJSON(w, http.StatusForbidden, map[string]any{"ok": 0, "error": "HTTPS required"})
				return
			}

			if !ipAllowed(r.RemoteAddr, global.AllowedIPs) {
				writeJSON(w, http.StatusForbidden, map[string]any{"ok": 0, "error": "Forbidden"})
				return
			}

			tok := r.Header.Get("X-API-Token")
			if tok == "" {
				if ah := r.Header.Get("Authorization"); strings.HasPrefix(strings.ToLower(ah), "bearer ") {
					tok = strings.TrimSpace(ah[7:])
				}
			}
			if subtle.ConstantTimeCompare([]byte(tok), []byte(apiToken)) != 1 {
				writeJSON(w, http.StatusUnauthorized, map[string]any{"ok": 0, "error": "Unauthorized"})
				return
			}

			r.Body = http.MaxBytesReader(w, r.Body, MaxRequestSize)
			h(w, r)
		}
	}

	routeGET := func(p string, h http.HandlerFunc) { route("GET", p, withAuth(h)) }
	routePOST := func(p string, h http.HandlerFunc) { route("POST", p, withAuth(h)) }
	routeDEL := func(p string, h http.HandlerFunc) { route("DELETE", p, withAuth(h)) }
	anyAuth := func(p string, h http.HandlerFunc) { any(p, withAuth(h)) }

	routeGET("/", func(w http.ResponseWriter, r *http.Request) {
		writeJSON(w, 200, map[string]any{"info": "Postfix Agent", "version": Version})
	})

	routeGET("/instances", func(w http.ResponseWriter, r *http.Request) {
		names := make([]string, 0, len(appcfg.Instances))
		for n := range appcfg.Instances {
			names = append(names, n)
		}
		sort.Strings(names)
		writeJSON(w, 200, map[string]any{"instances": names})
	})

	anyAuth("/instances/", func(w http.ResponseWriter, r *http.Request) {
		handleInstancesPrefix(w, r, appcfg, configsPath)
	})

	routeGET("/health", func(w http.ResponseWriter, r *http.Request) {
		tmp := global.TmpDir
		if tmp == "" {
			tmp = "/tmp"
		}
		var missing []string
		if st, err := os.Stat(tmp); err != nil || !st.IsDir() {
			missing = append(missing, tmp)
		}
		for name, ci := range appcfg.Instances {
			bdir := effectiveBackupDir(global, name, ci)
			if bdir != "" {
				if st, err := os.Stat(bdir); err != nil || !st.IsDir() {
					missing = append(missing, bdir)
				}
			}
		}
		if len(missing) > 0 {
			writeJSON(w, 500, map[string]any{"ok": 0, "error": "Missing dirs: " + strings.Join(missing, " ")})
			return
		}
		writeJSON(w, 200, map[string]any{"ok": 1, "status": "ok"})
	})

	routeDEL("/instances/_noop", func(w http.ResponseWriter, r *http.Request) {
		writeJSON(w, 404, map[string]any{"ok": 0, "error": "Not found"})
	})

	anyAuth("/", func(w http.ResponseWriter, r *http.Request) {
		writeJSON(w, 404, map[string]any{"ok": 0, "error": "Not found"})
	})

	listen := global.Listen
	if listen == "" {
		listen = "0.0.0.0:5000"
	}
	log.Printf("Listening at http://%s (require_https=%v)", listen, global.RequireHTTPS)
	if err := http.ListenAndServe(listen, mux); err != nil {
		log.Fatalf("ListenAndServe failed: %v", err)
	}
}

/* -------------------- Prefix Router fuer /instances/... -------------------- */

func handleInstancesPrefix(w http.ResponseWriter, r *http.Request, appcfg *AppConfig, configsPath string) {
	path := strings.TrimPrefix(r.URL.Path, "/instances/")
	if path == "" {
		writeJSON(w, 404, map[string]any{"ok": 0, "error": "Not found"})
		return
	}
	parts := strings.SplitN(path, "/", 2)
	instRaw := parts[0]
	rest := ""
	if len(parts) == 2 {
		rest = parts[1]
	}

	instName := resolveInstName(instRaw, appcfg.Instances)
	if instName == "" {
		writeJSON(w, 400, map[string]any{"ok": 0, "error": "Instance required"})
		return
	}
	ci := appcfg.Instances[instName]
	if ci == nil {
		writeJSON(w, 404, map[string]any{"ok": 0, "error": "Unknown instance"})
		return
	}

	switch {
	case r.Method == "GET" && rest == "maps":
		hListMaps(w, r, instName, ci)
		return

	case r.Method == "GET" && strings.HasPrefix(rest, "map/"):
		m := strings.TrimPrefix(rest, "map/")
		hGetMap(w, r, instName, ci, m)
		return

	case r.Method == "POST" && strings.HasPrefix(rest, "map/"):
		m := strings.TrimPrefix(rest, "map/")
		hSaveMap(w, r, appcfg, instName, ci, m)
		return

	case r.Method == "GET" && strings.HasPrefix(rest, "backup/"):
		m := strings.TrimPrefix(rest, "backup/")
		hListBackups(w, r, appcfg, instName, ci, m)
		return

	case r.Method == "GET" && strings.HasPrefix(rest, "backupfile/"):
		b := strings.TrimPrefix(rest, "backupfile/")
		hGetBackupFile(w, r, appcfg, instName, ci, b)
		return

	case r.Method == "POST" && strings.HasPrefix(rest, "restore/"):
		b := strings.TrimPrefix(rest, "restore/")
		hRestoreBackup(w, r, appcfg, instName, ci, b)
		return

	case r.Method == "POST" && strings.HasPrefix(rest, "delmap/"):
		m := strings.TrimPrefix(rest, "delmap/")
		hDelMap(w, r, appcfg, configsPath, instName, ci, m)
		return

	case rest == "globs" && r.Method == "GET":
		hGlobsGet(w, r, configsPath, instName)
		return

	case rest == "globs" && r.Method == "POST":
		hGlobsUpsert(w, r, appcfg, configsPath, instName)
		return

	case strings.HasPrefix(rest, "globs/") && r.Method == "DELETE":
		m := strings.TrimPrefix(rest, "globs/")
		hGlobsDelete(w, r, appcfg, configsPath, instName, m)
		return

	default:
		writeJSON(w, 404, map[string]any{"ok": 0, "error": "Not found"})
		return
	}
}

