	Secret       string   `json:"secret"`
	Logfile      string   `json:"logfile"`
	Listen       string   `json:"listen"`
	AllowedIPs   []string `json:"allowed_ips"`
	SSLenable    bool     `json:"ssl_enable"`
	SSLcert      string   `json:"ssl_cert_file"`
	SSLkey       string   `json:"ssl_key_file"`
	RequireHTTPS bool     `json:"require_https"`

	APIToken string `json:"api_token"`

	ServiceUser     string `json:"serviceUser"`
	ServiceGroup    string `json:"serviceGroup"`
	FileModeService string `json:"fileMode_service"`
	FileModeBackup  string `json:"fileMode_backup"`

	BackupDir    string `json:"backupDir"`
	TmpDir       string `json:"tmpDir"`
	LockDir      string `json:"lockDir"`
	ReloadGraceS any    `json:"reload_grace_s"`

