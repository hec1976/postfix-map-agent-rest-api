func hGlobsUpsert(w http.ResponseWriter, r *http.Request, appcfg *AppConfig, configsPath string, inst string) {
	type item struct {
		Map  string `json:"map"`
		Type string `json:"type"`
	}
	type applied struct {
		Map          string `json:"map"`
		Type         string `json:"type"`
		Action       string `json:"action"`
		PreviousType any    `json:"previous_type"`
	}

	var payload any
	_ = json.NewDecoder(r.Body).Decode(&payload)

	var items []item
	if m, ok := payload.(map[string]any); ok && len(m) > 0 {
		if arr, ok2 := m["items"].([]any); ok2 {
			for _, it := range arr {
				if mm, ok3 := it.(map[string]any); ok3 {
					items = append(items, item{Map: fmt.Sprint(mm["map"]), Type: fmt.Sprint(mm["type"])})
				}
			}
		} else {
			items = append(items, item{Map: fmt.Sprint(m["map"]), Type: fmt.Sprint(m["type"])})
		}
	} else {
		items = append(items, item{Map: r.FormValue("map"), Type: r.FormValue("type")})
	}

	if len(items) == 0 || items[0].Map == "" || items[0].Type == "" {
		writeJSON(w, 400, map[string]any{"ok": 0, "error": "Payload fehlt oder ungueltig"})
		return
	}

	allowedTypes := map[string]bool{
		"regexp": true, "pcre": true, "cidr": true, "lmdb": true, "hash": true, "btree": true, "db": true,
	}

	cfg, err := loadConfigsFile(configsPath)
	if err != nil {
		writeJSON(w, 500, map[string]any{"ok": 0, "error": "configs.json lesen: " + err.Error()})
		return
	}
	node := cfg.Instances[inst]
	if node == nil {
		node = &InstanceConfig{}
		cfg.Instances[inst] = node
	}
	if node.Globs == nil {
		node.Globs = map[string]string{}
	}

	seen := map[string]bool{}
	var appliedList []applied

	for _, it := range items {
		if it.Map == "" {
			writeJSON(w, 400, map[string]any{"ok": 0, "error": "map fehlt"})
			return
		}
		if it.Type == "" {
			writeJSON(w, 400, map[string]any{"ok": 0, "error": "type fehlt"})
			return
		}

		k, e := sanitizeGlobKey(it.Map)
		if e != "" {
			writeJSON(w, 400, map[string]any{"ok": 0, "error": "ungueltiger map-key: " + e})
			return
		}
		t, e2 := sanitizeGlobVal(it.Type)
		if e2 != "" {
			writeJSON(w, 400, map[string]any{"ok": 0, "error": "ungueltiger type: " + e2})
			return
		}
		if !allowedTypes[t] {
			writeJSON(w, 400, map[string]any{"ok": 0, "error": "ungueltiger type: " + t})
			return
		}

		key := k + "\x1f" + t
		if seen[key] {
			continue
		}
		seen[key] = true

		prev, had := node.Globs[k]
		node.Globs[k] = t
		act := "created"
		if had {
			act = "updated"
		}
		appliedList = append(appliedList, applied{Map: k, Type: t, Action: act, PreviousType: prev})
	}

	if err := saveConfigsFileAtomic(configsPath, cfg, appcfg.Global); err != nil {
		writeJSON(w, 500, map[string]any{"ok": 0, "error": "configs.json schreiben: " + err.Error()})
		return
	}

	appcfg.Instances = cfg.Instances
	writeJSON(w, 200, map[string]any{"ok": 1, "instance": inst, "upserted": appliedList})
}

func hGlobsDelete(w http.ResponseWriter, r *http.Request, appcfg *AppConfig, configsPath string, inst string, mapKey string) {
	cfg, err := loadConfigsFile(configsPath)
	if err != nil {
		writeJSON(w, 500, map[string]any{"ok": 0, "error": "configs.json lesen: " + err.Error()})
		return
	}
	node := cfg.Instances[inst]
	had := false
	if node != nil && node.Globs != nil {
		if _, ok := node.Globs[mapKey]; ok {
			delete(node.Globs, mapKey)
			had = true
		}
	}
	if err := saveConfigsFileAtomic(configsPath, cfg, appcfg.Global); err != nil {
		writeJSON(w, 500, map[string]any{"ok": 0, "error": "configs.json schreiben: " + err.Error()})
		return
	}
	appcfg.Instances = cfg.Instances
	writeJSON(w, 200, map[string]any{"ok": 1, "instance": inst, "map": mapKey, "removed": had})
}

