/* -------------------- Sanitizer -------------------- */

func sanitizeMapName(s string) (string, string) {
	s = filepath.Base(s)
	s = strings.TrimSpace(s)
	if s == "" {
		return "", "Empty"
	}
	ok, _ := regexp.MatchString(`^[0-9A-Za-z._-]{1,255}$`, s)
	if !ok {
		return "", "Invalid characters"
	}
	if s == "." || s == ".." || strings.Contains(s, "/") || strings.Contains(s, "\\") || strings.Contains(s, "..") {
		return "", "Path traversal detected"
	}
	return s, ""
}

func sanitizeGlobKey(s string) (string, string) {
	s = strings.TrimSpace(s)
	if s == "" {
		return "", "Empty"
	}
	ok, _ := regexp.MatchString(`^[0-9A-Za-z._*\-]{1,255}$`, s)
	if !ok {
		return "", "Invalid characters"
	}
	if strings.Contains(s, "/") || strings.Contains(s, "\\") || strings.Contains(s, "..") {
		return "", "Path traversal detected"
	}
	return s, ""
}

func sanitizeGlobVal(s string) (string, string) {
	s = strings.TrimSpace(s)
	if s == "" {
		return "", "Empty"
	}
	low := strings.ToLower(s)
	ok, _ := regexp.MatchString(`^[a-z0-9_\-]{1,32}$`, low)
	if !ok {
		return "", "Invalid characters"
	}
	return low, ""
}

func denyForbiddenMap(name string) bool {
	n := strings.ToLower(name)
	return n == "main.cf" || n == "master.cf"
}

/* -------------------- Ownership + Mode (wie Perl set_file_ownership_and_mode) -------------------- */

type ChownPolicy int

const (
	ChownStrict ChownPolicy = iota
	ChownWarn
	ChownIgnore
)

func chownPolicyFromString(s string) ChownPolicy {
	switch strings.ToLower(strings.TrimSpace(s)) {
	case "ignore":
		return ChownIgnore
	case "warn":
		return ChownWarn
	default:
		return ChownStrict
	}
}

func parseModeString(s string) (os.FileMode, bool) {
	s = strings.TrimSpace(s)
	if s == "" {
		return 0, false
	}
	if regexp.MustCompile(`^[0-7]{3,4}$`).MatchString(s) {
		v, err := strconv.ParseUint(s, 8, 32)
		if err != nil {
			return 0, false
		}
		return os.FileMode(v), true
	}
	if regexp.MustCompile(`^\d+$`).MatchString(s) {
		v, err := strconv.ParseUint(s, 10, 32)
		if err != nil {
			return 0, false
		}
		return os.FileMode(v), true
	}
	return 0, false
}

func lookupUID(user string) (int, error) {
	user = strings.TrimSpace(user)
	if user == "" {
		return -1, nil
	}
	if regexp.MustCompile(`^\d+$`).MatchString(user) {
		v, _ := strconv.Atoi(user)
		return v, nil
	}
	b, err := os.ReadFile("/etc/passwd")
	if err != nil {
		return -1, err
	}
	for _, ln := range strings.Split(string(b), "\n") {
		if ln == "" || strings.HasPrefix(ln, "#") {
			continue
		}
		parts := strings.Split(ln, ":")
		if len(parts) < 4 {
			continue
		}
		if parts[0] == user {
			uid, _ := strconv.Atoi(parts[2])
			return uid, nil
		}
	}
	return -1, fmt.Errorf("unknown user: %s", user)
}

func lookupGID(group string) (int, error) {
	group = strings.TrimSpace(group)
	if group == "" {
		return -1, nil
	}
	if regexp.MustCompile(`^\d+$`).MatchString(group) {
		v, _ := strconv.Atoi(group)
		return v, nil
	}
	b, err := os.ReadFile("/etc/group")
	if err != nil {
		return -1, err
	}
	for _, ln := range strings.Split(string(b), "\n") {
		if ln == "" || strings.HasPrefix(ln, "#") {
			continue
		}
		parts := strings.Split(ln, ":")
		if len(parts) < 3 {
			continue
		}
		if parts[0] == group {
			gid, _ := strconv.Atoi(parts[2])
			return gid, nil
		}
	}
	return -1, fmt.Errorf("unknown group: %s", group)
}

func setFileOwnershipAndMode(path string, user string, group string, modeStr string, policy ChownPolicy) error {
	var errs []string

	if strings.TrimSpace(user) != "" || strings.TrimSpace(group) != "" {
		uid, uerr := lookupUID(user)
		gid, gerr := lookupGID(group)

		if uerr != nil {
			errs = append(errs, uerr.Error())
		}
		if gerr != nil {
			errs = append(errs, gerr.Error())
		}

		if uerr == nil && gerr == nil {
			if err := os.Chown(path, uid, gid); err != nil {
				errs = append(errs, "chown failed: "+err.Error())
			}
		}
	}

	if m, ok := parseModeString(modeStr); ok {
		if err := os.Chmod(path, m); err != nil {
			errs = append(errs, "chmod failed: "+err.Error())
		}
	}

	if len(errs) == 0 {
		return nil
	}

	msg := strings.Join(errs, "; ")
	switch policy {
	case ChownIgnore:
		return nil
	case ChownWarn:
		log.Printf("WARN: setFileOwnershipAndMode(%s): %s", path, msg)
		return nil
	default:
		return fmt.Errorf(msg)
	}
}

/* -------------------- Atomic write (wie Perl atomic_write + atomic_write_umask) -------------------- */

func atomicWriteWithMeta(target string, content []byte, g *GlobalConfig, umaskOnly bool) error {
	dir := filepath.Dir(target)
	if !isWritableDir(dir) {
		return fmt.Errorf("Verzeichnis nicht beschreibbar: %s", dir)
	}

	pol := ChownWarn
	if g != nil {
		pol = chownPolicyFromString(g.ChownPolicy)
	}

	tmp := ""
	for i := 0; i < 128; i++ {
		cand := filepath.Join(dir, fmt.Sprintf(".tmp_%d_%d", os.Getpid(), rand.Intn(1_000_000_000)))
		f, err := os.OpenFile(cand, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0666)
		if err != nil {
			continue
		}
		tmp = cand

		_, werr := f.Write(content)
		cerr := f.Close()
		if werr != nil || cerr != nil {
			_ = os.Remove(tmp)
			if werr != nil {
				return werr
			}
			return cerr
		}

		if g != nil {
			if umaskOnly {
				_ = setFileOwnershipAndMode(tmp, g.ServiceUser, g.ServiceGroup, "", pol)
			} else {
				_ = setFileOwnershipAndMode(tmp, g.ServiceUser, g.ServiceGroup, g.FileModeService, pol)
			}
		}
		break
	}
	if tmp == "" {
		return fmt.Errorf("atomic_write: konnte keine Temp-Datei erstellen in %s", dir)
	}

	if err := os.Rename(tmp, target); err != nil {
		_ = os.Remove(tmp)
		return err
	}

	if g != nil {
		if umaskOnly {
			return setFileOwnershipAndMode(target, g.ServiceUser, g.ServiceGroup, "", pol)
		}
		return setFileOwnershipAndMode(target, g.ServiceUser, g.ServiceGroup, g.FileModeService, pol)
	}

	return nil
}

func isWritableDir(dir string) bool {
	st, err := os.Stat(dir)
	if err != nil || !st.IsDir() {
		return false
	}
	test := filepath.Join(dir, fmt.Sprintf(".wtest_%d", os.Getpid()))
	if err := os.WriteFile(test, []byte("x"), 0600); err != nil {
		return false
	}
	_ = os.Remove(test)
	return true
}

/* -------------------- Backup + rotate -------------------- */

func backupFile(src string, backupDir string, max int, g *GlobalConfig) error {
	if backupDir == "" {
		return nil
	}
	_ = os.MkdirAll(backupDir, 0770)

	base := filepath.Base(src)
	dst := filepath.Join(backupDir, base+".bak."+tsCompact(time.Now()))
	data, err := os.ReadFile(src)
	if err != nil {
		return err
	}

	if err := os.WriteFile(dst, data, 0660); err != nil {
		return err
	}

	if g != nil {
		pol := chownPolicyFromString(g.ChownPolicy)
		mode := strings.TrimSpace(g.FileModeBackup)
		if mode == "" {
			mode = g.FileModeService
		}
		_ = setFileOwnershipAndMode(dst, g.ServiceUser, g.ServiceGroup, mode, pol)
	}

	if max > 0 {
		pat := filepath.Join(backupDir, base+".bak.*")
		files, _ := filepath.Glob(pat)
		sort.Slice(files, func(i, j int) bool {
			si, _ := os.Stat(files[i])
			sj, _ := os.Stat(files[j])
			if si == nil || sj == nil {
				return files[i] < files[j]
			}
			return si.ModTime().Before(sj.ModTime())
		})
		if len(files) > max {
			for _, f := range files[:len(files)-max] {
				_ = os.Remove(f)
			}
		}
	}

	return nil
}

func tsCompact(t time.Time) string {
	return t.Format("20060102_150405")
}

/* -------------------- Glob Cache -------------------- */

func (ci *InstanceConfig) ensureGlobCache() {
	ci._globCacheOnce.Do(func() {
		ci._globRegex = map[string]*regexp.Regexp{}
		ci._globOrder = nil
		if ci.Globs == nil {
			return
		}
		for k := range ci.Globs {
			if strings.Contains(k, "*") {
				ci._globRegex[k] = globToRegex(k)
				ci._globOrder = append(ci._globOrder, k)
			}
		}
	})
}

func globToRegex(glob string) *regexp.Regexp {
	re := regexp.QuoteMeta(glob)
	re = strings.ReplaceAll(re, `\*`, ".*")
	return regexp.MustCompile("^" + re + "$")
}

func mapTypeForFile(ci *InstanceConfig, file string) string {
	if ci.Globs == nil {
		return ""
	}
	if v, ok := ci.Globs[file]; ok {
		return v
	}
	ci.ensureGlobCache()
	for _, g := range ci._globOrder {
		if re := ci._globRegex[g]; re != nil && re.MatchString(file) {
			return ci.Globs[g]
		}
	}
	return ""
}

/* -------------------- Commands + status -------------------- */

func expandCmd(g *GlobalConfig, ci *InstanceConfig, inst string, cmd string) string {
	cmd = strings.TrimSpace(cmd)
	if cmd == "" {
		return ""
	}
	bdir := effectiveBackupDir(g, inst, ci)
	out := cmd
	out = strings.ReplaceAll(out, "{inst}", inst)
	out = strings.ReplaceAll(out, "{config_dir}", ci.ConfigDir)
	out = strings.ReplaceAll(out, "{map_dir}", ci.MapDir)
	out = strings.ReplaceAll(out, "{backup_dir}", bdir)
	return out
}

func postmapCmd(ci *InstanceConfig, inst string, file string) string {
	typ := mapTypeForFile(ci, file)
	if typ == "" || ci.PostmapByType == nil {
		return ""
	}
	tmpl := strings.TrimSpace(ci.PostmapByType[typ])
	if tmpl == "" {
		return ""
	}
	p := filepath.Join(ci.MapDir, file)
	out := tmpl
	out = strings.ReplaceAll(out, "{config_dir}", ci.ConfigDir)
	out = strings.ReplaceAll(out, "{path}", p)
	out = strings.ReplaceAll(out, "{inst}", inst)
	return out
}

type runRes struct {
	Rc     int
	Output string
}

func runCmd(cmd string) runRes {
	args, err := shellSplit(cmd)
	if err != nil || len(args) == 0 {
		return runRes{Rc: 255, Output: "empty command"}
	}
	c := exec.Command(args[0], args[1:]...)
	var buf bytes.Buffer
	c.Stdout = &buf
	c.Stderr = &buf
	err = c.Run()
	out := buf.String()
	rc := 0
	if err != nil {
		var ee *exec.ExitError
		if errors.As(err, &ee) {
			rc = ee.ExitCode()
		} else {
			rc = 255
		}
	}
	return runRes{Rc: rc, Output: out}
}

func runCmdStrict(cmd string, slot *CmdResult, label string) {
	cmd = strings.TrimSpace(cmd)
	if cmd == "" {
		*slot = CmdResult{Executed: false}
		return
	}
	r := runCmd(cmd)
	slot.Executed = true
	slot.Command = cmd
	slot.Rc = r.Rc
	slot.Output = r.Output
	if r.Rc == 0 {
		slot.Result = "ok"
		return
	}
	slot.Result = "fail"
	slot.Error = fmt.Sprintf("%s rc=%d: %s", label, r.Rc, strings.TrimSpace(r.Output))
}

func runCmdWarn(cmd string, slot *CmdResult, label string) {
	cmd = strings.TrimSpace(cmd)
	if cmd == "" {
		*slot = CmdResult{Executed: false}
		return
	}
	r := runCmd(cmd)
	slot.Executed = true
	slot.Command = cmd
	slot.Rc = r.Rc
	slot.Output = r.Output
	if r.Rc == 0 {
		slot.Result = "ok"
		return
	}
	slot.Result = "warn"
	slot.Warning = fmt.Sprintf("%s rc=%d (will verify via status)", label, r.Rc)
}

func parseServiceStatus(out string, rc int) string {
	t := strings.ToLower(strings.TrimSpace(strings.ReplaceAll(out, "\r", "")))
	if t == "" {
		if rc == 0 {
			return "unknown-ok"
		}
		return "unknown-fail"
	}
	if regexp.MustCompile(`\b(active|running)\b`).MatchString(t) {
		return "running"
	}
	if regexp.MustCompile(`\bpid:\s*\d+\b`).MatchString(t) {
		return "running"
	}
	if strings.Contains(t, "postfix mail system is running") {
		return "running"
	}
	if regexp.MustCompile(`\b(not\s+running|inactive|dead|failed|stopp?ed)\b`).MatchString(t) {
		if rc == 0 {
			return "unknown-ok"
		}
		return "stopped"
	}
	if rc == 0 {
		return "running"
	}
	if rc == 1 {
		return "stopped"
	}
	return "unknown-fail"
}

func numSeconds(v any, def float64) float64 {
	switch x := v.(type) {
	case float64:
		return x
	case int:
		return float64(x)
	case string:
		f, err := strconv.ParseFloat(strings.TrimSpace(x), 64)
		if err == nil {
			return f
		}
	}
	return def
}

func statusVerify(g *GlobalConfig, ci *InstanceConfig, inst string, slot *CmdResult) error {
	grace := DefaultGraceS
	if g != nil {
		grace = numSeconds(g.ReloadGraceS, DefaultGraceS)
	}
	time.Sleep(time.Duration(grace * float64(time.Second)))

	cmd := expandCmd(g, ci, inst, ci.StatusCmd)
	if strings.TrimSpace(cmd) == "" {
		*slot = CmdResult{Executed: false}
		return nil
	}

	r := runCmd(cmd)
	slot.Executed = true
	slot.Command = cmd
	slot.Rc = r.Rc
	slot.Output = r.Output

	st := parseServiceStatus(r.Output, r.Rc)
	slot.Result = st

	if st == "running" {
		return nil
	}
	if st == "unknown-ok" {
		slot.Warning = "Status nicht eindeutig (toleriert)"
		return nil
	}
	if r.Rc == 0 {
		slot.Warning = "Status meldet nicht running, aber rc=0 (toleriert)"
		return nil
	}
	slot.Warning = fmt.Sprintf("Status meldet '%s' (rc=%d)", st, r.Rc)
	return nil
}

/* -------------------- Request content -------------------- */

func readContentFromRequest(r *http.Request) (string, error) {
	ct := strings.ToLower(r.Header.Get("Content-Type"))
	bodyBytes, _ := io.ReadAll(r.Body)

	if strings.Contains(ct, "application/json") {
		var j any
		if err := json.Unmarshal(bodyBytes, &j); err == nil {
			switch t := j.(type) {
			case map[string]any:
				if v, ok := t["content"]; ok {
					return fmt.Sprint(v), nil
				}
				b, _ := json.Marshal(t)
				return string(b), nil
			default:
				return fmt.Sprint(t), nil
			}
		}
	}

	if v := r.FormValue("content"); v != "" {
		return v, nil
	}
	return string(bodyBytes), nil
}

/* -------------------- Locking -------------------- */

func lockDirFor(g *GlobalConfig, ci *InstanceConfig, inst string) string {
	if ci != nil && strings.TrimSpace(ci.LockDir) != "" {
		return ci.LockDir
	}
	if g != nil && strings.TrimSpace(g.LockDir) != "" {
		return g.LockDir
	}
	base := "/tmp"
	if g != nil && strings.TrimSpace(g.TmpDir) != "" {
		base = g.TmpDir
	}
	return filepath.Join(base, "postfix-agent-locks", inst)
}

func withMapLock(g *GlobalConfig, ci *InstanceConfig, inst string, mapName string, exclusive bool, fn func() error) error {
	ldir := lockDirFor(g, ci, inst)
	if err := os.MkdirAll(ldir, 0770); err != nil {
		return err
	}
	lpath := filepath.Join(ldir, mapName+".lock")

	f, err := os.OpenFile(lpath, os.O_CREATE|os.O_RDWR, 0660)
	if err != nil {
		return err
	}
	defer f.Close()

	deadline := time.Now().Add(time.Duration(DefaultLockS * float64(time.Second)))
	for {
		how := syscall.LOCK_SH
		if exclusive {
			how = syscall.LOCK_EX
		}
		err = syscall.Flock(int(f.Fd()), how|syscall.LOCK_NB)
		if err == nil {
			defer syscall.Flock(int(f.Fd()), syscall.LOCK_UN)
			return fn()
		}
		if time.Now().After(deadline) {
			return fmt.Errorf("Lock-Timeout (%s)", mapName)
		}
		time.Sleep(50 * time.Millisecond)
	}
}

/* -------------------- shell split -------------------- */

func shellSplit(s string) ([]string, error) {
	var out []string
	var cur bytes.Buffer
	inS := false
	inD := false
	esc := false

	flush := func() {
		if cur.Len() > 0 {
			out = append(out, cur.String())
			cur.Reset()
		}
	}

	for i := 0; i < len(s); i++ {
		ch := s[i]
		if esc {
			cur.WriteByte(ch)
			esc = false
			continue
		}
		if ch == '\\' && !inS {
			esc = true
			continue
		}
		if ch == '\'' && !inD {
			inS = !inS
			continue
		}
		if ch == '"' && !inS {
			inD = !inD
			continue
		}
		if !inS && !inD && (ch == ' ' || ch == '\t' || ch == '\n' || ch == '\r') {
			flush()
			continue
		}
		cur.WriteByte(ch)
	}
	if esc || inS || inD {
		return nil, fmt.Errorf("unclosed quotes or escape")
	}
	flush()
	return out, nil
}
