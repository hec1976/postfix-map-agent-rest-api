func hListMaps(w http.ResponseWriter, r *http.Request, inst string, ci *InstanceConfig) {
	seen := map[string]bool{}
	wantAll := r.URL.Query().Get("all") == "1"

	globs := ci.Globs
	if globs == nil {
		globs = map[string]string{}
	}

	if wantAll || len(globs) == 0 {
		entries, err := os.ReadDir(ci.MapDir)
		if err == nil {
			for _, e := range entries {
				n := e.Name()
				if strings.HasPrefix(n, ".") {
					continue
				}
				if denyForbiddenMap(n) {
					continue
				}
				if !e.IsDir() {
					seen[n] = true
				}
			}
		}
	} else {
		for glob := range globs {
			matches, _ := filepath.Glob(filepath.Join(ci.MapDir, glob))
			for _, f := range matches {
				bn := filepath.Base(f)
				if denyForbiddenMap(bn) {
					continue
				}
				st, err := os.Stat(f)
				if err == nil && st.Mode().IsRegular() {
					seen[bn] = true
				}
			}
		}
	}

	var maps []string
	for k := range seen {
		maps = append(maps, k)
	}
	sort.Strings(maps)

	writeJSON(w, 200, map[string]any{"ok": 1, "maps": maps})
}

func hGetMap(w http.ResponseWriter, r *http.Request, inst string, ci *InstanceConfig, mapName string) {
	m, err := sanitizeMapName(mapName)
	if err != "" {
		writeJSON(w, 400, map[string]any{"ok": 0, "error": err})
		return
	}
	if denyForbiddenMap(m) {
		writeJSON(w, 400, map[string]any{"ok": 0, "error": "forbidden map name"})
		return
	}
	p := filepath.Join(ci.MapDir, m)
	data, err2 := os.ReadFile(p)
	if err2 != nil {
		writeJSON(w, 404, map[string]any{"ok": 0, "error": "Not found"})
		return
	}
	w.Header().Set("Content-Type", "text/plain; charset=UTF-8")
	w.WriteHeader(200)
	_, _ = w.Write(data)
}

func hListBackups(w http.ResponseWriter, r *http.Request, appcfg *AppConfig, inst string, ci *InstanceConfig, mapName string) {
	base, err := sanitizeMapName(mapName)
	if err != "" {
		writeJSON(w, 400, map[string]any{"ok": 0, "error": err})
		return
	}
	if denyForbiddenMap(base) {
		writeJSON(w, 400, map[string]any{"ok": 0, "error": "forbidden map name"})
		return
	}

	bdir := effectiveBackupDir(appcfg.Global, inst, ci)
	if bdir == "" {
		writeJSON(w, 404, map[string]any{"ok": 0, "error": "No backup_dir"})
		return
	}

	pat := filepath.Join(bdir, base+".bak.*")
	files, _ := filepath.Glob(pat)

	sort.Slice(files, func(i, j int) bool {
		si, _ := os.Stat(files[i])
		sj, _ := os.Stat(files[j])
		if si == nil || sj == nil {
			return files[i] > files[j]
		}
		return sj.ModTime().Before(si.ModTime())
	})

	out := make([]string, 0, len(files))
	for _, f := range files {
		out = append(out, filepath.Base(f))
	}

	writeJSON(w, 200, map[string]any{"ok": 1, "backups": out})
}

func hGetBackupFile(w http.ResponseWriter, r *http.Request, appcfg *AppConfig, inst string, ci *InstanceConfig, backup string) {
	bf, err := sanitizeMapName(backup)
	if err != "" {
		writeJSON(w, 400, map[string]any{"ok": 0, "error": err})
		return
	}

	bdir := effectiveBackupDir(appcfg.Global, inst, ci)
	if bdir == "" {
		writeJSON(w, 500, map[string]any{"ok": 0, "error": "No backup dir"})
		return
	}
	full := filepath.Join(bdir, bf)
	st, err2 := os.Stat(full)
	if err2 != nil || !st.Mode().IsRegular() {
		writeJSON(w, 404, map[string]any{"ok": 0, "error": "Backup file not found"})
		return
	}

	mode := r.URL.Query().Get("mode")
	if mode == "" {
		mode = "text"
	}

	data, _ := os.ReadFile(full)
	content := strings.ReplaceAll(string(data), "\r\n", "\n")

	if mode == "download" {
		w.Header().Set("Content-Disposition", fmt.Sprintf(`attachment; filename="%s"`, bf))
		w.Header().Set("Content-Type", "application/octet-stream")
		w.WriteHeader(200)
		_, _ = w.Write([]byte(content))
		return
	}

	if mode == "json" {
		writeJSON(w, 200, map[string]any{
			"ok":      1,
			"name":    bf,
			"size":    len(content),
			"content": content,
		})
		return
	}

	w.Header().Set("Content-Type", "text/plain; charset=UTF-8")
	w.WriteHeader(200)
	_, _ = w.Write([]byte(content))
}

func hSaveMap(w http.ResponseWriter, r *http.Request, appcfg *AppConfig, inst string, ci *InstanceConfig, mapName string) {
	res := SaveResult{
		Ok:      1,
		Error:   "",
		Changed: 0,
		Backup:  "skipped",
		Write:   "skipped",
		Postmap: CmdResult{Executed: false},
		Reload:  CmdResult{Executed: false},
		Status:  CmdResult{Executed: false},
	}

	m, san := sanitizeMapName(mapName)
	if san != "" {
		res.Ok = 0
		res.Error = san
		writeJSON(w, 400, res)
		return
	}
	if denyForbiddenMap(m) {
		writeJSON(w, 400, map[string]any{"ok": 0, "error": "forbidden map name"})
		return
	}

	target := filepath.Join(ci.MapDir, m)

	newContent, err := readContentFromRequest(r)
	if err != nil {
		res.Ok = 0
		res.Error = err.Error()
		writeJSON(w, 400, res)
		return
	}
	if newContent == "" {
		if _, e := os.Stat(target); errors.Is(e, os.ErrNotExist) {
			newContent = "#\n"
		}
	}
	newContent = strings.ReplaceAll(newContent, "\r\n", "\n")

	dir := filepath.Dir(target)
	if err := os.MkdirAll(dir, 0770); err != nil || !isWritableDir(dir) {
		res.Ok = 0
		res.Error = "Directory not writable"
		writeJSON(w, 403, res)
		return
	}

	old := ""
	if b, e := os.ReadFile(target); e == nil {
		old = string(b)
	}
	old = strings.ReplaceAll(old, "\r\n", "\n")

	if newContent == old {
		writeJSON(w, 200, res)
		return
	}
	res.Changed = 1

	lockErr := withMapLock(appcfg.Global, ci, inst, m, true, func() error {
		bdir := effectiveBackupDir(appcfg.Global, inst, ci)
		if _, e := os.Stat(target); e == nil {
			_ = backupFile(target, bdir, ci.MaxBackups, appcfg.Global)
			res.Backup = "ok"
		} else {
			res.Backup = "not_existing"
		}

		if err := atomicWriteWithMeta(target, []byte(newContent), appcfg.Global, false); err != nil {
			return err
		}
		res.Write = "ok"

		if cmd := postmapCmd(ci, inst, m); cmd != "" {
			runCmdStrict(cmd, &res.Postmap, "postmap")
		}
		if ci.ReloadOnChange {
			reloadCmd := expandCmd(appcfg.Global, ci, inst, ci.ReloadCmd)
			runCmdWarn(reloadCmd, &res.Reload, "reload")
			_ = statusVerify(appcfg.Global, ci, inst, &res.Status)
		}
		return nil
	})

	if lockErr != nil {
		if strings.Contains(lockErr.Error(), "Lock-Timeout") {
			writeJSON(w, 423, map[string]any{"ok": 0, "error": "Map locked (timeout)"})
			return
		}
		res.Ok = 0
		res.Error = lockErr.Error()
		writeJSON(w, 500, res)
		return
	}

	writeJSON(w, 200, res)
}

func hRestoreBackup(w http.ResponseWriter, r *http.Request, appcfg *AppConfig, inst string, ci *InstanceConfig, backupFileName string) {
	bf, san := sanitizeMapName(backupFileName)
	if san != "" {
		writeJSON(w, 400, map[string]any{"ok": 0, "error": san})
		return
	}

	bdir := effectiveBackupDir(appcfg.Global, inst, ci)
	if bdir == "" {
		writeJSON(w, 500, map[string]any{"ok": 0, "error": "No backup dir"})
		return
	}

	src := filepath.Join(bdir, bf)
	if st, err := os.Stat(src); err != nil || !st.Mode().IsRegular() {
		writeJSON(w, 404, map[string]any{"ok": 0, "error": "Backup file not found"})
		return
	}

	mapName := bf
	if i := strings.Index(mapName, ".bak."); i >= 0 {
		mapName = mapName[:i]
	}
	if denyForbiddenMap(mapName) {
		writeJSON(w, 400, map[string]any{"ok": 0, "error": "forbidden map name"})
		return
	}

	dst := filepath.Join(ci.MapDir, mapName)
	res := RestoreResult{
		Ok:       1,
		Restored: bf,
		Target:   dst,
		Postmap:  CmdResult{Executed: false},
		Reload:   CmdResult{Executed: false},
		Status:   CmdResult{Executed: false},
	}

	lockErr := withMapLock(appcfg.Global, ci, inst, mapName, true, func() error {
		data, err := os.ReadFile(src)
		if err != nil {
			return err
		}
		if err := atomicWriteWithMeta(dst, data, appcfg.Global, false); err != nil {
			return err
		}
		if cmd := postmapCmd(ci, inst, mapName); cmd != "" {
			runCmdStrict(cmd, &res.Postmap, "postmap")
		}
		if ci.ReloadOnChange {
			reloadCmd := expandCmd(appcfg.Global, ci, inst, ci.ReloadCmd)
			runCmdWarn(reloadCmd, &res.Reload, "reload")
			_ = statusVerify(appcfg.Global, ci, inst, &res.Status)
		}
		return nil
	})

	if lockErr != nil {
		if strings.Contains(lockErr.Error(), "Lock-Timeout") {
			writeJSON(w, 423, map[string]any{"ok": 0, "error": "Map locked (timeout)"})
			return
		}
		res.Ok = 0
		res.Error = lockErr.Error()
		writeJSON(w, 500, res)
		return
	}
	writeJSON(w, 200, res)
}

func hDelMap(w http.ResponseWriter, r *http.Request, appcfg *AppConfig, configsPath string, inst string, ci *InstanceConfig, mapName string) {
	m, san := sanitizeMapName(mapName)
	if san != "" {
		writeJSON(w, 400, map[string]any{"ok": 0, "error": san})
		return
	}
	if denyForbiddenMap(m) {
		writeJSON(w, 400, map[string]any{"ok": 0, "error": "forbidden map name"})
		return
	}

	cfg, err := loadConfigsFile(configsPath)
	if err != nil {
		writeJSON(w, 500, map[string]any{"ok": 0, "error": "configs.json lesen: " + err.Error()})
		return
	}
	node := cfg.Instances[inst]
	if node == nil {
		node = &InstanceConfig{}
		cfg.Instances[inst] = node
	}
	if node.Globs == nil {
		node.Globs = map[string]string{}
	}

	removed := false
	if _, ok := node.Globs[m]; ok {
		delete(node.Globs, m)
		removed = true
	}

	if err := saveConfigsFileAtomic(configsPath, cfg, appcfg.Global); err != nil {
		writeJSON(w, 500, map[string]any{"ok": 0, "error": "configs.json schreiben: " + err.Error()})
		return
	}

	// rebuild in memory
	appcfg.Instances = cfg.Instances

	var matched []string
	if !removed {
		ci.ensureGlobCache()
		for _, g := range ci._globOrder {
			re := ci._globRegex[g]
			if re != nil && re.MatchString(m) {
				matched = append(matched, g)
			}
		}
	}

	action := ""
	msg := ""
	if removed {
		action = "removed"
		msg = fmt.Sprintf("Eintrag in configs.json globs der Instanz '%s' wurde fuer '%s' entfernt.", inst, m)
	} else if len(matched) > 0 {
		action = "pattern_only"
		msg = fmt.Sprintf("Kein exakter Eintrag fuer '%s' in configs.json globs der Instanz '%s'. Datei ist aber durch Muster abgedeckt: %s. Es wurde nichts geaendert.", m, inst, strings.Join(matched, ", "))
	} else {
		action = "not_registered"
		msg = fmt.Sprintf("Fuer '%s' existiert kein Eintrag in configs.json globs der Instanz '%s'. Es wurde nichts geaendert.", m, inst)
	}
	msg += " Diese API loescht keine Dateien. Bitte bereinige Verweise in main.cf/master.cf bei Bedarf."

	out := DeleteMapResult{
		Ok:              1,
		Instance:        inst,
		Map:             m,
		Action:          action,
		MatchedPatterns: matched,
		ChangedConfigs:  removed,
		ActionRequired:  msg,
		Note:            "Kein Reload und keine Datei-Loeschung durchgefuehrt (Policy).",
		ConfigsFile:     configsPath,
	}
	writeJSON(w, 200, out)
}

