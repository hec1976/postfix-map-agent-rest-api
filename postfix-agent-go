	}
	if g.ServiceUser == "" {
		g.ServiceUser = "root"
	}
	if g.ServiceGroup == "" {
		g.ServiceGroup = "root"
	}
	if g.FileModeService == "" {
		g.FileModeService = "0644"
	}
	if g.FileModeBackup == "" {
		g.FileModeBackup = "0660"
	}
	if g.Listen == "" {
		g.Listen = "0.0.0.0:5000"
	}
	if g.ChownPolicy == "" {
		g.ChownPolicy = "warn"
	}
	return &g
}

func mustLoadInstances(configsPath string, g *GlobalConfig) *AppConfig {
	cfg, err := loadConfigsFile(configsPath)
	if err != nil {
		log.Fatalf("parse %s failed: %v", configsPath, err)
	}
	if cfg.Instances == nil {
		cfg.Instances = map[string]*InstanceConfig{}
	}
	return &AppConfig{Global: g, Instances: cfg.Instances}
}

func loadConfigsFile(path string) (*ConfigsFile, error) {
	b, err := os.ReadFile(path)
	if err != nil {
		return nil, err
	}

	// Variante A: {"instances":{...}}
	var wrapper ConfigsFile
	if err := json.Unmarshal(b, &wrapper); err == nil && wrapper.Instances != nil {
		return &wrapper, nil
	}

	// Variante B: direkt {...}
	var direct map[string]*InstanceConfig
	if err := json.Unmarshal(b, &direct); err != nil {
		return nil, err
	}
	return &ConfigsFile{Instances: direct}, nil
}

func saveConfigsFileAtomic(path string, cfg *ConfigsFile, g *GlobalConfig) error {
	out, err := json.MarshalIndent(cfg, "", "  ")
	if err != nil {
		return err
	}
	out = append(out, '\n')
	return atomicWriteWithMeta(path, out, g, true) // configs.json: umask-only, kein chmod erzwingen wenn du willst
}

