{
  "postfix": {
    "backup_dir": "\/opt\/mmbb_services\/postfix-agent\/backup\/postfix",
    "config_dir": "\/etc\/postfix",
    "globs": {
      "transport": "lmdb",
      "header_checks": "regexp"
    },
    "map_dir": "\/etc\/postfix",
    "max_backups": 50,
    "postmap_by_type": {
      "lmdb": "\/usr\/sbin\/postmap -c {config_dir} {path}",
      "pcre": "",
      "regexp": ""
    },
    "reload_cmd": "systemctl reload postfix",
    "reload_on_change": true,
    "status_cmd": "systemctl is-active postfix"
  }
}
