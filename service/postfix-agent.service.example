[Unit]
Description=Postfix Agent (hardened)
Wants=network-online.target
After=network.target network-online.target
RequiresMountsFor=/opt/mmbb_services

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=/opt/mmbb_services/env/postfix-agent.env
WorkingDirectory=/opt/mmbb_services/postfix-agent
ExecStart=/usr/bin/perl /opt/mmbb_services/postfix-agent/postfix-agent.pl
UMask=0007

# PATH + ENV härten
Environment=PATH=/usr/bin:/usr/sbin
UnsetEnvironment=PERL5LIB PERLLIB PERL5OPT IFS CDPATH ENV BASH_ENV LD_PRELOAD LD_LIBRARY_PATH

# Restart
TimeoutStartSec=30
Restart=on-failure
RestartSec=3s

# Sandboxing
NoNewPrivileges=yes
RestrictSUIDSGID=yes
ProtectSystem=strict
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
PrivateTmp=true
PrivateDevices=true
PrivateMounts=true
LockPersonality=yes
RestrictNamespaces=yes
RestrictRealtime=yes
KeyringMode=private
ProcSubset=pid
ProtectProc=invisible
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service chroot

# Netzwerk nur Loopback
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# IPAddressDeny=any
# IPAddressAllow=127.0.0.1 ::1

# Temporäres Dateisystem restriktiv
TemporaryFileSystem=/


# --- Binaries / Libs (Read-Only) ---
BindReadOnlyPaths=/usr:/usr
BindReadOnlyPaths=/usr/share:/usr/share
BindReadOnlyPaths=/lib:/lib
BindReadOnlyPaths=/lib64:/lib64
BindReadOnlyPaths=/bin:/bin
BindReadOnlyPaths=/sbin:/sbin

# --- /etc Basis (Read-Only) ---
BindReadOnlyPaths=/etc/hosts
BindReadOnlyPaths=/etc/resolv.conf
BindReadOnlyPaths=/etc/nsswitch.conf
BindReadOnlyPaths=/etc/localtime
BindReadOnlyPaths=/etc/machine-id

# systemctl reload/status aus den fest konfigurierten Instanz-Kommandos.
# Das Laufzeitverzeichnis bleibt read-only; Unix-Socket-Verbindungen bleiben moeglich.
BindReadOnlyPaths=/run/systemd:/run/systemd


#-----------------------------------
# Verzeichnis schreiben
#-----------------------------------
BindPaths=/var/log:/var/log
BindPaths=/opt/mmbb_services/postfix-agent:/opt/mmbb_services/postfix-agent
BindPaths=/etc/postfix:/etc/postfix

#-----------------------------------
# Verzeichnis lesen
#-----------------------------------
BindReadOnlyPaths=/etc/postfix/main.cf:/etc/postfix/main.cf
BindReadOnlyPaths=/etc/postfix/master.cf:/etc/postfix/master.cf

# Caps minimal (keine nötig)
CapabilityBoundingSet=CAP_CHOWN

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mmbb-postfix-agent

[Install]
WantedBy=multi-user.target
